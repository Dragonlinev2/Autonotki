<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Autonotki.Client"
             x:Class="Autonotki.Client.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Autonotki.Client/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://Autonotki.Client/Styles/Typography.axaml"/>
                <ResourceInclude Source="avares://Autonotki.Client/Styles/Controls.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Autonotki.Client/Styles/GlobalStyles.axaml"/>
    </Application.Styles>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

</Application>

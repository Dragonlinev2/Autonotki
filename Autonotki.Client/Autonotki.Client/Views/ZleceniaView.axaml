<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Autonotki.Client.Controls"
             x:Class="Autonotki.Client.Views.ZleceniaView"
             Background="{StaticResource PageBackgroundBrush}">

    <!--
        ViewModel: ZleceniaViewModel
          - SelectedDate: DateTime  (bound to DatePicker)
          - SelectedDateDisplay: string ("11.05.2026")
          - FilterAll / FilterTodo / FilterInProgress / FilterDone: ICommand
          - ActiveFilter: FilterType (enum)
          - Orders: ObservableCollection<ZlecenieCardViewModel>
    -->

    <Grid RowDefinitions="Auto,*">

        <!-- Top Navigation Bar -->
        <controls:TopNavBar Grid.Row="0" DataContext="{Binding NavVM}"/>

        <!-- Page Content -->
        <ScrollViewer Grid.Row="1" Padding="40,32">

            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="24">

                <!-- Page Title -->
                <TextBlock Text="ZLECENIA"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           LetterSpacing="1"/>

                <!-- Filter Bar -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">

                    <!-- Date selector -->
                    <ComboBox Grid.Column="0"
                              SelectedItem="{Binding SelectedDateDisplay}"
                              MinWidth="160"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              FontSize="14">
                        <!-- In real impl: DatePicker or custom dropdown -->
                    </ComboBox>

                    <!-- Filter buttons -->
                    <Button Grid.Column="1"
                            Content="Wszystkie"
                            Theme="{StaticResource FilterButtonSelectedStyle}"
                            Command="{Binding FilterAllCommand}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Content="Do zrobienia"
                            Theme="{StaticResource FilterButtonStyle}"
                            Command="{Binding FilterTodoCommand}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="3"
                            Content="W toku"
                            Theme="{StaticResource FilterButtonStyle}"
                            Command="{Binding FilterInProgressCommand}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="4"
                            Content="Zrobione"
                            Theme="{StaticResource FilterButtonStyle}"
                            Command="{Binding FilterDoneCommand}"/>

                </Grid>

                <!-- Orders List -->
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ZlecenieCard DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <TextBlock Text="Brak zleceń dla wybranego filtra."
                           FontSize="15"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,40"
                           IsVisible="{Binding IsEmpty}"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>

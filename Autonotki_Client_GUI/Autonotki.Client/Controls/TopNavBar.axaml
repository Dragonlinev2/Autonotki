<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Autonotki.Client.Controls.TopNavBar">

    <Border Background="{StaticResource NavyBlueBrush}"
            Height="60">
        <Grid ColumnDefinitions="*,Auto">

            <!-- Navigation Links -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">

                <Button Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToDodajCommand}">
                    Dodaj zlecenie
                </Button>

                <Button Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToEdytujCommand}">
                    Edytuj zlecenie
                </Button>

                <Button Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToPrzegladajCommand}">
                    Przeglądaj zlecenia
                </Button>

                <Button Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToKalendarzCommand}">
                    Kalendarz
                </Button>

                <Button Theme="{StaticResource NavButtonStyle}"
                        Command="{Binding NavigateToUstawieniaCommand}">
                    Ustawienia
                </Button>

            </StackPanel>

            <!-- Right: Bell + Avatar -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Spacing="12">

                <!-- Notification Bell -->
                <Grid>
                    <Button Theme="{StaticResource NavButtonStyle}"
                            Padding="8"
                            Command="{Binding OpenNotificationsCommand}">
                        <!-- Bell icon using Unicode -->
                        <TextBlock Text="🔔"
                                   FontSize="20"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!-- Badge -->
                    <Border Classes="NotificationBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0">
                        <TextBlock Text="{Binding NotificationCount}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- User Avatar -->
                <Button Theme="{StaticResource NavButtonStyle}"
                        Padding="4"
                        Command="{Binding OpenProfileCommand}">
                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#4A5E8A">
                        <TextBlock Text="👤"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>

            </StackPanel>
        </Grid>
    </Border>

</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Autonotki.Client.Views"
        x:Class="Autonotki.Client.MainWindow"
        Title="Autonotki"
        MinWidth="1024"
        MinHeight="680"
        Background="{StaticResource PageBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="False">

    <!--
        MainWindowViewModel manages:
          - CurrentPage: INotifyPropertyChanged (the active view)
          - Navigation between pages via NavigateTo(page)
    -->

    <!-- Single ContentControl that swaps views -->
    <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type views:HomeView}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:KalendarzView}">
                <views:KalendarzView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:ZleceniaView}">
                <views:ZleceniaView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:DodajZlecenieView}">
                <views:DodajZlecenieView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type views:EdytujZlecenieView}">
                <views:EdytujZlecenieView/>
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>

</Window>

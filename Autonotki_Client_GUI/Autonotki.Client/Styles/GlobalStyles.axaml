<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default TextBlock font -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial, sans-serif"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Default TextBox -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial, sans-serif"/>
    </Style>

    <!-- Separator line helper -->
    <Style Selector="Border.VerticalSeparator">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

    <!-- Status dot helper styles -->
    <Style Selector="Ellipse.StatusOrange">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource OrangeStatusBrush}"/>
    </Style>

    <Style Selector="Ellipse.StatusGreen">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource GreenStatusBrush}"/>
    </Style>

    <!-- Image placeholder -->
    <Style Selector="Border.ImagePlaceholder">
        <Setter Property="Background" Value="#D6E8F5"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Notification badge -->
    <Style Selector="Border.NotificationBadge">
        <Setter Property="Background" Value="{StaticResource OrangeStatusBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="5,0"/>
    </Style>

</Styles>
